bohr
-5.342  0.000  5.342
 0.000  5.342  5.342
-5.342  5.342  0.000
End Unit_Cell_Cart

Begin Atoms_Frac
Ga   0.00   0.00   0.00
As  -0.25   0.75  -0.25
End Atoms_Frac

Begin Projections
Ga : s ; p
As : s ; p
End Projections

