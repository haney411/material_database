! GaAs bulk (zincblende), PBE, no SOC
! 8 WFs: Ga s,p + As s,p  (spans 4 valence + 4 lowest conduction bands)
num_bands         = 19
num_wann          = 8
exclude_bands     = 1-5          ! Ga 3d semicore (~ -15 eV below VBM)

dis_win_max       = 20.0d0        ! VBM+13.3 eV
dis_froz_max      = 13.9d0        ! VBM+7.2 eV, just below band-14 minimum (14.00 eV)
dis_num_iter      = 500
dis_conv_tol      = 1.0d-10
dis_mix_ratio     = 0.5

num_iter          = 300
conv_tol          = 1.0d-10
conv_window       = 5
num_print_cycles  = 20

write_tb          = true
write_xyz         = true
write_hr          = true
translate_home_cell = true

!restart          = plot
bands_plot        = true
bands_num_points  = 100

