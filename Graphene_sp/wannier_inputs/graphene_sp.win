! Graphene sp model: 8 Wannier functions, s;p on each carbon.
!
! Orbital order per site: s, pz, px, py
!   WF 1-4 = sublattice A,  WF 5-8 = sublattice B
! so a site potential is a block-diagonal perturbation of H(R=0).
!
! num_iter = 0 on purpose.  Unconstrained maximal localisation is free to
! rotate s and p on one atom into bond-pointing hybrids, and it does: it moved
! two WFs onto the C-C bonds and made the site assignment meaningless, while
! also making the occupied bands WORSE (26 -> 34 meV).  The projection gauge
! keeps exact atomic character on each site.  site_symmetry would be the
! principled alternative but this build's symmetrize_ukirr does not converge
! here and it refuses a frozen window; slwf_constrain is inert because
! wannier90 only enables it when slwf_num < num_wann.

num_bands         = 60
num_wann          = 8

dis_win_max       = 40.0
! Projectability disentanglement (Qiao et al., arXiv:2303.07877), supported in
! wannier90 3.1 via dis_proj_min/max.  Energy windows CANNOT separate this
! manifold: graphene's sigma* bands lie above the vacuum level and overlap in
! energy with the vacuum/interlayer states, so no choice of dis_froz_* selects
! sigma* without also admitting vacuum states.  Projectability selects on
! atomic-orbital CHARACTER instead: states below dis_proj_min are discarded,
! those at or above dis_proj_max are frozen.
! Projectability to DISCARD the vacuum states (they carry essentially no
! atomic character), combined with an ENERGY frozen window to pin the occupied
! bands.  Projectability alone localises beautifully but un-pins the bands
! (spreads 0.62-0.75 Ang^2 but 545 meV band error); the energy window alone
! keeps the bands but cannot exclude the vacuum continuum.  Both together.
dis_proj_min      = 0.01
dis_proj_max      = 1.0
dis_froz_min      = -27.0
dis_froz_max      = 0.73
dis_num_iter      = 600
dis_conv_tol      = 1.0e-9
dis_mix_ratio     = 0.5

num_iter          = 0
num_print_cycles  = 100

guiding_centres   = .true.

write_tb          = true
write_hr          = true
write_rmn         = true
write_xyz         = true
write_u_matrices  = true
use_ws_distance   = true

bands_plot        = true
bands_num_points  = 100

Begin Atoms_Frac
C  0.3333333333  0.6666666667  0.0000000000
C  0.6666666667  0.3333333333  0.0000000000
End Atoms_Frac

Begin Projections
f=0.3333333333,0.6666666667,0.0000000000 : s;p
f=0.6666666667,0.3333333333,0.0000000000 : s;p
End Projections

begin kpoint_path
G 0.0000000000 0.0000000000 0.0000000000  M 0.5000000000 0.0000000000 0.0000000000
M 0.5000000000 0.0000000000 0.0000000000  K 0.3333333333 0.3333333333 0.0000000000
K 0.3333333333 0.3333333333 0.0000000000  G 0.0000000000 0.0000000000 0.0000000000
end kpoint_path

Begin Unit_Cell_Cart
bohr
    4.6487262666     0.0000000000     0.0000000000
   -2.3243631333     4.0259150421     0.0000000000
    0.0000000000     0.0000000000    37.1898101326
End Unit_Cell_Cart

mp_grid      = 15 15 1

