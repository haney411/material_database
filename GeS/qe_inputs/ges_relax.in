&CONTROL
  calculation   = 'relax'
  prefix        = 'ges'
  outdir        = './tmp_relax'
  pseudo_dir    = '/home/haney411/wrk/qe/SSSP_1.3.0_PBE_efficiency'
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-6
/

&SYSTEM
  ibrav         = 8             ! orthorhombic: x = armchair (polar axis), y = zigzag, z = vacuum
  celldm(1)     = 8.314795     ! a = 4.40 A (PBE, Gomes & Carvalho PRB 92, 085406)
  celldm(2)     = 0.83636364    ! b = 3.68 A
  celldm(3)     = 4.54545455    ! c = 20 A
  nat           = 4
  ntyp          = 2
  ecutwfc       = 45.0          ! GBRV USPP (SSSP eff.: Ge 40, S 35 Ry)
  ecutrho       = 360.0         ! 8x for USPP
/

&ELECTRONS
  conv_thr      = 1.0d-10
/

&IONS
  ion_dynamics  = 'bfgs'
/

ATOMIC_SPECIES
  Ge  72.630  ge_pbe_v1.4.uspp.F.UPF
  S   32.065  s_pbe_v1.4.uspp.F.UPF

ATOMIC_POSITIONS {crystal}
  Ge   0.000  0.25  0.559
  S    0.140  0.25  0.441
  Ge   0.500  0.75  0.441
  S    0.640  0.75  0.559

K_POINTS {automatic}
  10 12 1 0 0 0
