&CONTROL
  calculation   = 'bands'
  prefix        = 'ges'
  outdir        = './tmp_bands'
  pseudo_dir    = '/home/haney411/wrk/qe/SSSP_1.3.0_PBE_efficiency'
  verbosity     = 'high'
/

&SYSTEM
  ibrav         = 0             ! a,b from Gomes & Carvalho PRB 92 085406 (PBE); atoms relaxed; x = armchair/polar, y = zigzag
  nat           = 4
  ntyp          = 2
  ecutwfc       = 45.0
  ecutrho       = 360.0         ! 8x for USPP
  nbnd          = 40
/

&ELECTRONS
  conv_thr      = 1.0d-10
  diago_full_acc = .true.
/

