G 0.00000  0.00000  0.0000   M 0.50000  0.00000  0.0000
M 0.50000  0.00000  0.0000   K 0.33333  0.33333  0.0000
K 0.33333  0.33333  0.0000   G 0.00000  0.00000  0.0000
end kpoint_path

bands_num_points  = 100

