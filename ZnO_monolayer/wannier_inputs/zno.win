num_bands         =   20
num_wann          =    4

! Exclude deep semicore: Zn 3s, Zn 3p, O 2s (5 bands)
exclude_bands : 1-5

! Disentanglement windows (absolute eV; from NSCF).
! VBM = -3.81 eV, CBM = -2.13 eV, gap = 1.68 eV.
! Zn 3d range = [-9.98, -7.96]; O 2p range = [-7.57, -3.81]; Zn 4s (band 14) = [-2.13, +3.03].
! dis_win:  cleanly separates O 2p + Zn 4s from the Zn 3d block below.
! dis_froz: holds the 3 O 2p bands always; band 14 falls in frozen near the CBM
!           (4 bands max in frozen = num_wann ✓).
dis_win_min       =  -7.7
dis_win_max       =   5.0
dis_froz_min      =  -7.7
dis_froz_max      =  -1.7
dis_num_iter      =  500
dis_mix_ratio     =  1.0

num_iter          =  500
num_print_cycles  =  20

guiding_centres   = .true.
write_tb          = true
write_xyz         = true

restart           = plot
bands_plot        = true

Begin Atoms_Frac
Zn   0.333333333  0.666666667  0.500000
O    0.666666667  0.333333333  0.500000
End Atoms_Frac

Begin Projections
Zn : s
O  : p
End Projections

